{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "free_debug",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_free.dart",
      "args": [
        "--flavor",
        "free"
      ]
    },
    {
      "name": "free_profile",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_free.dart",
      "flutterMode": "profile",
      "args": [
        "--flavor",
        "free"
      ]
    },
    {
      "name": "free_release",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_free.dart",
      "flutterMode": "release",
      "args": [
        "--flavor",
        "free"
      ]
    },
    {
      "name": "pro_debug",
      "type": "dart",
      "request": "launch",
      "program": "lib/main_pro.dart",
      "flutterMode": "debug",
      "args": [
        "--flavor",
        "pro"
      ]
    },
    {
      "name": "pro_profile",
      "type": "dart",
      "request": "launch",
      "program": "lib/main_pro.dart",
      "flutterMode": "profile",
      "args": [
        "--flavor",
        "pro"
      ]
    },
    {
      "name": "pro_release",
      "type": "dart",
      "request": "launch",
      "program": "lib/main_pro.dart",
      "flutterMode": "release",
      "args": [
        "--flavor",
        "pro"
      ]
    },
    {
      "name": "Run All Tests",
      "request": "launch",
      "type": "dart",
      "program": "./test/",
      "args": [
        "--coverage"
      ]
    }
  ]
}